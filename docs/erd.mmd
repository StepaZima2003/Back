  Expense {
    uuid id
    uuid collection_id
    string title
    int amount_minor
    string currency
    string expense_type
    uuid category_id
    string comment
  }

  ExpenseShareRule {
    uuid id
    uuid expense_id
    uuid expense_item_id
    uuid category_id
    uuid participant_id
    string split_mode
    float weight
    int fixed_amount_minor
    float percent
    int cap_amount_minor
    bool excluded
    string reason
