{
  "name": "social-split-app",
  "version": "0.1.0",
  "private": true,
  "description": "MVP backend foundation for SocialSplitApp.",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/runIntegrationTests.ts",
    "test:integration:vitest": "vitest run --config vitest.integration.config.ts",
    "autopay:sweep": "tsx scripts/runAutoPaymentSweep.ts",
    "autopay:worker": "tsx scripts/runAutoPaymentWorker.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.8.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
