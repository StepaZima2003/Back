  User {
    uuid id
    string phone
    string display_name
    string avatar_url
    string status
    string verification_level
    datetime created_at
    datetime updated_at
  }

  Collection {
    uuid id
    string title
    string type
    uuid group_id
    uuid organizer_id
    string currency
    string status
    string payment_mode
    int total_amount_minor
    datetime review_deadline_at
    datetime payment_deadline_at
    datetime created_at
    datetime updated_at
  }

  CollectionParticipant {
    uuid id
    uuid collection_id
    string participant_type
    uuid linked_user_id
    string display_name_snapshot
    uuid payment_responsible_participant_id
    string relationship_hint
    float default_weight
    string status
    int final_share_amount_minor
    string payment_status
